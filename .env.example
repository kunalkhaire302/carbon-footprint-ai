APP_ENV=development
API_HOST=127.0.0.1
API_PORT=5000
FRONTEND_URL=http://localhost:5000
ALLOWED_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
LOG_LEVEL=INFO
